#!/usr/bin/env python3
"""cca-sync --binary BIN --home CONFIG --target CONFIG --state FILE --servers FILE [--no-trust] [--no-mcp] CONFIG...

Before Claude Code starts on an account, gives the account's config (its
.claude.json, --target) what every account shares, from the configs of all
accounts (CONFIG...):

  - user MCP servers live in one file (--servers, in the format
    `claude --mcp-config` reads), which cca passes to every session. A user
    server found in an account's config (mcpServers[<name>], where
    `claude mcp add --scope user` puts it) is moved into the file, and the
    account starting, and ~/.claude.json, are left holding none. To change
    or remove a server, edit the file.
  - folder trust, projects[<path>].hasTrustDialogAccepted: the union of all
    accounts. Trust is only added, never taken away.
  - per-project MCP settings: the local servers
    (projects[<path>].mcpServers[<name>]) and the answers given to a
    project's .mcp.json servers (projects[<path>].enabledMcpjsonServers and
    disabledMcpjsonServers). One added, changed or removed on any account is
    added, changed or removed on all of them; ~/.claude.json (--home) holds
    the shared copy.

To tell a change made on an account from a copy it has not caught up on,
the state file keeps, per account, a digest of each item as cca last saw it
there: digests only, never a server's command, URL or secrets. An account
seen for the first time adds what it has without replacing what is shared.

Writes follow Claude Code's own: under its lock (proper-lockfile's directory,
<config>.lock), a re-read, then a temp file renamed over the config with its
permissions kept. A lock held by a running session is never broken: the sync
is skipped and the next start tries again.

A folder the account has never opened gets Claude Code's default project
entry, read from the binary (Claude Code reads an entry as written, without
filling in defaults) and cached per binary.
"""
import argparse
import contextlib
import copy
import fcntl
import hashlib
import json
import mmap
import os
import re
import secrets
import sys
import time

CACHE = os.path.join(os.environ.get('CCA_ROOT') or os.path.expanduser('~/.claude-shared/accounts'), 'cache')
# The default entry, as the bundle spells it:
# {allowedTools:[],mcpContextUris:[],mcpServers:{},...,hasTrustDialogAccepted:!1,...}
DEFAULTS_ANCHOR = re.compile(rb'\{allowedTools:\[\],[A-Za-z]+:')
LITERAL_VALUES = {b'[]': [], b'{}': {}, b'!0': True, b'!1': False}
LOCK_WAIT_S = 3.0
TRUST = 'hasTrustDialogAccepted'
APPROVALS = ('enabledMcpjsonServers', 'disabledMcpjsonServers')


def warn(message):
    print(f'cca: {message}', file=sys.stderr)


def parse_defaults(blob):
    """The default project entry from a JS bundle, or None when it is not
    there in the expected shape (every value [], {}, !0 or !1)."""
    match = DEFAULTS_ANCHOR.search(blob)
    if match is None:
        return None
    depth = 0
    for end in range(match.start(), min(match.start() + 2000, len(blob))):
        char = blob[end:end + 1]
        if char == b'{':
            depth += 1
        elif char == b'}':
            depth -= 1
            if depth == 0:
                break
    else:
        return None
    entry = {}
    for field in bytes(blob[match.start() + 1:end]).split(b','):
        key, sep, value = field.partition(b':')
        if not sep or not re.fullmatch(rb'[A-Za-z]+', key) or value not in LITERAL_VALUES:
            return None
        entry[key.decode()] = copy.deepcopy(LITERAL_VALUES[value])
    return entry if entry.get(TRUST) is False else None


def project_defaults(binary):
    """parse_defaults of the binary, cached by the binary's real path and size."""
    real = os.path.realpath(binary)
    key = re.sub(r'[^A-Za-z0-9.]', '_', f'{os.path.basename(real)}-{os.path.getsize(real)}')
    cached = os.path.join(CACHE, f'project-defaults-{key}.json')
    if os.path.exists(cached):
        with open(cached) as f:
            return json.load(f)
    with open(real, 'rb') as f, mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ) as blob:
        entry = parse_defaults(blob)
    if entry is None:
        warn(f'no default project entry found in {real}; folders an account never opened get nothing synced')
        return None
    os.makedirs(CACHE, exist_ok=True)
    with open(cached, 'w') as f:
        json.dump(entry, f)
    return entry


# --- the shared items of a config ------------------------------------------
# A config's shared items are a flat map from a key, the path to the value
# (a tuple), to the value: ('mcpServers', name), ('projects', folder, TRUST),
# ('projects', folder, 'mcpServers', name), ('projects', folder, <approvals>).

def is_trust(key):
    return len(key) == 3 and key[2] == TRUST


def is_user(key):
    return len(key) == 2


def dict_at(parent, name):
    value = parent.get(name)
    return value if isinstance(value, dict) else {}


def items(config):
    """Every shared item of a parsed config. An untrusted folder and an empty
    approvals list hold no item."""
    found = {('mcpServers', name): server for name, server in dict_at(config, 'mcpServers').items()}
    for folder, entry in dict_at(config, 'projects').items():
        if not isinstance(entry, dict):
            continue
        if entry.get(TRUST) is True:
            found[('projects', folder, TRUST)] = True
        for name, server in dict_at(entry, 'mcpServers').items():
            found[('projects', folder, 'mcpServers', name)] = server
        for field in APPROVALS:
            if entry.get(field):
                found[('projects', folder, field)] = entry[field]
    return found


def label(key):
    if len(key) == 2:
        return key[1]
    if len(key) == 4:
        return f'{key[3]} in {key[1]}'
    return f'.mcp.json approvals in {key[1]}'


def name_of(key):
    return json.dumps(list(key))


def digest(value):
    return hashlib.sha256(json.dumps(value, sort_keys=True).encode()).hexdigest()


def absorb(shared, current, base):
    """Applies to shared (changed in place) what changed on an account since
    cca last saw it there: base is that sighting's digests, None on first sight."""
    for key, value in current.items():
        if base is None:
            shared.setdefault(key, value)
        elif base.get(name_of(key)) != digest(value):
            shared[key] = value
    for name in base or {}:
        key = tuple(json.loads(name))
        if key not in current and not is_trust(key):
            shared.pop(key, None)


def adopt(servers, current, base):
    """Puts into servers (the shared file's, changed in place) the user
    servers an account added or changed since cca last saw it there: base is
    that sighting's digests, or None on first sight, when what the account
    has joins without replacing. A copy cca saw before is left out, so an
    edit or removal made in the file stands. Returns the names put in."""
    adopted = []
    for key, value in current.items():
        name = key[1]
        if servers.get(name) == value:
            continue
        if (name in servers) if base is None else (base.get(name_of(key)) == digest(value)):
            continue
        servers[name] = value
        adopted.append(name)
    return adopted


def place(config, key, value, defaults):
    """Sets key to value in config; False when the folder has no entry and
    there is no default entry to make one from."""
    value = copy.deepcopy(value)
    if key[0] == 'mcpServers':
        config['mcpServers'] = {**dict_at(config, 'mcpServers'), key[1]: value}
        return True
    projects = config['projects'] = dict_at(config, 'projects')
    entry = projects.get(key[1])
    if not isinstance(entry, dict):
        if defaults is None:
            return False
        entry = projects[key[1]] = copy.deepcopy(defaults)
    if len(key) == 4:
        entry['mcpServers'] = {**dict_at(entry, 'mcpServers'), key[3]: value}
    else:
        entry[key[2]] = value
    return True


def drop(config, key):
    """Removes an item config holds. Trust is never removed."""
    if key[0] == 'mcpServers':
        del config['mcpServers'][key[1]]
    elif len(key) == 4:
        del config['projects'][key[1]]['mcpServers'][key[3]]
    else:
        config['projects'][key[1]][key[2]] = []


def conform(config, shared, wanted, defaults):
    """Makes config (changed in place) hold the shared items; returns the
    changes, {key: 'added' | 'changed' | 'removed'}."""
    have = {key: value for key, value in items(config).items() if wanted(key)}
    changes = {}
    for key in sorted(have.keys() - shared.keys()):
        if not is_trust(key):
            drop(config, key)
            changes[key] = 'removed'
    for key in sorted(shared):
        if key not in have:
            if place(config, key, shared[key], defaults):
                changes[key] = 'added'
        elif have[key] != shared[key]:
            place(config, key, shared[key], defaults)
            changes[key] = 'changed'
    return changes


# --- files and locks ---------------------------------------------------------

class Locked(Exception):
    pass


@contextlib.contextmanager
def claude_lock(config_path):
    """Claude Code's lock on a config: the directory <config>.lock."""
    lock = f'{config_path}.lock'
    deadline = time.monotonic() + LOCK_WAIT_S
    delay = 0.02
    while True:
        try:
            os.mkdir(lock)
            break
        except FileExistsError:
            if time.monotonic() >= deadline:
                raise Locked(config_path)
            time.sleep(delay)  # waiting on another process's lock, as proper-lockfile retries
            delay = min(delay * 2, 0.25)
    try:
        yield
    finally:
        os.rmdir(lock)


@contextlib.contextmanager
def state_lock(state_path):
    """One cca-sync at a time: a lock the OS releases if this process dies."""
    os.makedirs(os.path.dirname(state_path), exist_ok=True)
    with open(f'{state_path}.lock', 'a') as handle:
        deadline = time.monotonic() + LOCK_WAIT_S
        while True:
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise Locked(state_path)
                time.sleep(0.05)  # another cca starting a session at the same moment
        yield


def read_config(path):
    with open(path) as f:
        config = json.load(f)
    if not isinstance(config, dict):
        raise ValueError('not a JSON object')
    return config


def write_config(path, config):
    mode = os.stat(path).st_mode & 0o7777
    temp = f'{path}.tmp.cca.{os.getpid()}.{secrets.token_hex(6)}'
    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            f.write(json.dumps(config, indent=2, ensure_ascii=False))
            f.flush()
            os.fsync(f.fileno())
        os.chmod(temp, mode)
        os.rename(temp, path)
    except BaseException:
        if os.path.exists(temp):
            os.unlink(temp)
        raise


def load_servers(path):
    """The shared file's servers, none when it does not exist yet. Raises
    ValueError on a file that is not {"mcpServers": {...}}."""
    try:
        with open(path) as f:
            data = json.load(f)
    except FileNotFoundError:
        return {}
    if not isinstance(data, dict) or not isinstance(data.get('mcpServers', {}), dict):
        raise ValueError('not {"mcpServers": {...}}')
    return dict(data.get('mcpServers', {}))


def save_servers(path, servers):
    """Writes the shared file, private (it holds the servers' secrets) unless
    its owner has set other permissions."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    mode = os.stat(path).st_mode & 0o7777 if os.path.exists(path) else 0o600
    temp = f'{path}.tmp.cca.{os.getpid()}.{secrets.token_hex(6)}'
    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            f.write(json.dumps({'mcpServers': servers}, indent=2, ensure_ascii=False) + '\n')
            f.flush()
            os.fsync(f.fileno())
        os.chmod(temp, mode)
        os.rename(temp, path)
    except BaseException:
        if os.path.exists(temp):
            os.unlink(temp)
        raise


def load_state(path):
    try:
        with open(path) as f:
            state = json.load(f)
        if isinstance(state, dict):
            return state
        warn(f'{path} is not a JSON object; every account counts as seen for the first time')
    except FileNotFoundError:
        pass
    except (OSError, ValueError) as error:
        warn(f'{path} does not read ({error}); every account counts as seen for the first time')
    return {}


def save_state(path, state):
    temp = f'{path}.tmp'
    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as f:
        json.dump(state, f, indent=1, sort_keys=True)
        f.flush()
        os.fsync(f.fileno())
    os.chmod(temp, 0o600)
    os.replace(temp, path)


# --- the sync ----------------------------------------------------------------

def sighting(state, path, current, wanted):
    """The state entry for an account seen holding `current`, keeping the
    digests of the kinds this run did not sync."""
    kept = {name: value for name, value in (state.get(path) or {}).items() if not wanted(tuple(json.loads(name)))}
    return {**kept, **{name_of(key): digest(value) for key, value in current.items()}}


def report(changes, moved, servers_path):
    by = {kind: sorted({label(key) for key, change in changes.items() if change == kind and not is_trust(key)})
          for kind in ('added', 'changed', 'removed')}
    by['trusted'] = sorted(key[1] for key in changes if is_trust(key))
    by['moved'] = sorted(set(moved))
    if by['moved']:
        warn(f'MCP servers moved to {servers_path}, which every account loads: {", ".join(by["moved"])}')
    if by['trusted']:
        warn(f'trusted {len(by["trusted"])} folder(s) another account trusts: {", ".join(by["trusted"])}')
    parts = [f'{kind} {", ".join(by[kind])}' for kind in ('added', 'changed', 'removed') if by[kind]]
    if parts:
        warn(f'MCP servers from the other accounts: {"; ".join(parts)}')
    return by


def sync(home, target, configs, defaults, state_path, servers_path, trust=True, mcp=True):
    """Gives target, home's shared copy and the shared servers file what
    every account shares. Returns what changed ({'moved', 'trusted', 'added',
    'changed', 'removed'}), or None when it could not (target missing,
    unreadable or locked)."""
    def synced(key):  # what home's shared copy carries
        return False if is_user(key) else trust if is_trust(key) else mcp

    if not os.path.exists(target) or not os.path.exists(home):
        return None
    try:
        with state_lock(state_path):
            state = load_state(state_path)
            servers = None  # the shared file's servers, None when this run leaves them alone
            if mcp:
                try:
                    servers = load_servers(servers_path)
                except (OSError, ValueError) as error:
                    warn(f'{servers_path} does not read ({error}); user MCP servers stay where they are')

            def recorded(key):
                return synced(key) or (is_user(key) and servers is not None)

            def selected(config):
                return {key: value for key, value in items(config).items() if recorded(key)}

            def only(found, keep):
                return {key: value for key, value in found.items() if keep(key)}

            seen = {}
            for path in dict.fromkeys(configs):
                if path in (home, target):
                    continue
                try:
                    seen[path] = selected(read_config(path))
                except FileNotFoundError:
                    continue  # an account never started has nothing to share yet
                except (OSError, ValueError) as error:
                    warn(f'skipped {path} as a source: {error}')
            with claude_lock(home), (claude_lock(target) if target != home else contextlib.nullcontext()):
                try:
                    home_config = read_config(home)
                    target_config = home_config if target == home else read_config(target)
                except (OSError, ValueError) as error:
                    warn(f'{home} or {target} does not read ({error}); left alone')
                    return None
                # Home first and the account starting last, so its change wins a conflict.
                owners = [(home, selected(home_config))] + list(seen.items())
                if target != home:
                    owners.append((target, selected(target_config)))
                shared = only(selected(home_config), synced)
                for path, current in owners[1:]:
                    absorb(shared, only(current, synced), state.get(path))
                moved, emptied = [], set()
                if servers is not None:
                    before = dict(servers)
                    for path, current in owners:
                        moved += adopt(servers, only(current, is_user), state.get(path))
                    if servers != before:
                        save_servers(servers_path, servers)  # before the configs lose their copies
                    for path, config in ((home, home_config), (target, target_config)):
                        if dict_at(config, 'mcpServers'):
                            config['mcpServers'] = {}
                            emptied.add(path)
                changes = conform(target_config, shared, synced, defaults)
                if changes or target in emptied:
                    write_config(target, target_config)
                if target != home and (conform(home_config, shared, synced, defaults) or home in emptied):
                    write_config(home, home_config)
            for path, current in seen.items():
                state[path] = sighting(state, path, current, recorded)
            for path, config in {home: home_config, target: target_config}.items():
                state[path] = sighting(state, path, selected(config), recorded)
            save_state(state_path, state)
    except Locked as error:
        warn(f'{error} stayed locked by a running session; accounts sync at the next start')
        return None
    return report(changes, moved, servers_path)


def main():
    parser = argparse.ArgumentParser(prog='cca-sync')
    parser.add_argument('--binary', required=True)
    parser.add_argument('--home', required=True)
    parser.add_argument('--target', required=True)
    parser.add_argument('--state', required=True)
    parser.add_argument('--servers', required=True)
    parser.add_argument('--no-trust', dest='trust', action='store_false')
    parser.add_argument('--no-mcp', dest='mcp', action='store_false')
    parser.add_argument('configs', nargs='*')
    args = parser.parse_args()
    sync(args.home, args.target, args.configs, project_defaults(args.binary), args.state, args.servers,
         trust=args.trust, mcp=args.mcp)


if __name__ == '__main__':
    main()
