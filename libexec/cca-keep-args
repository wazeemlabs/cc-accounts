#!/usr/bin/env python3
"""cca-keep-args [--kept FILE] <claude binary> [args...]

Prints, NUL-separated, the args a relaunch on another account carries over:
every option except those that choose, start or end a session, and no prompt.
Which options take a value is read from `<claude binary> --help`.
Dropped args go to stderr, so the person sees what did not carry over.
With --kept, the model and effort the session ran on, which the plugin
writes beside the switch file, replace any --model or --effort in the args.
"""
import re
import subprocess
import sys

# Options that pick the conversation, or the point in it to open at: every
# relaunch, in a terminal or under cca-stream, resumes the conversation the
# switch names instead. Short spellings are listed too, for a caller that
# has no --help table to map them.
CONVERSATION = {
    '--resume', '-r', '--continue', '-c', '--session-id', '--fork-session', '--from-pr',
    '--resume-session-at', '--resume-drops-turn',
}
# What a terminal relaunch also drops: what starts something a second run
# must not repeat (a worktree, a cloud session, a download, a one-shot print).
DROP = CONVERSATION | {
    '--print', '--worktree', '--tmux', '--background', '--bg', '--cloud', '--teleport', '--desktop',
    '--environment', '--file', '--help', '--version',
}

# What a move keeps of the session as it ran, as the plugin writes it beside
# the switch file (keep.ts): `<name> <value>` lines, each the value of an
# option for the new process. They replace the first run's own, which the
# session may have changed since (/model, /effort).
KEPT_OPTIONS = {'model': '--model', 'effort': '--effort'}
KEPT_VALUE = re.compile(r'^[A-Za-z0-9._:/\[\]-]+$')

# "  -r, --resume [value]", "  --add-dir <directories...>", "  --bg, --background"
OPTION_LINE = re.compile(
    r'^  (?:(-[A-Za-z]), )?(--[\w-]+)(?:, (--[\w-]+))?(?: ([<\[])[^>\]]*?(\.\.\.)?[>\]])?(?:\s|$)')


def arities(help_text):
    """Maps every spelling of an option to its long name and arity:
    'flag', 'one', 'optional' or 'many'."""
    table = {}
    for line in help_text.splitlines():
        match = OPTION_LINE.match(line)
        if match is None:
            continue
        short, first, second, bracket, dots = match.groups()
        if dots:
            arity = 'many'
        elif bracket == '<':
            arity = 'one'
        elif bracket == '[':
            arity = 'optional'
        else:
            arity = 'flag'
        long_name = second or first
        for spelling in (short, first, second):
            if spelling:
                table[spelling] = (long_name, arity)
    return table


def keep(args, table, drop=DROP, keep_unknown=False):
    """Returns (kept, dropped) for a relaunch. An option `table` does not
    know is dropped, its value with it, unless `keep_unknown`: cca-stream
    keeps the hidden options the VS Code panel passes, and with no prompt on
    a stream-json command line, a token after an unknown option is its value."""
    kept, dropped = [], []
    i = 0
    while i < len(args):
        token = args[i]
        i += 1
        if token == '--':
            dropped.extend(args[i - 1:])
            break
        if not token.startswith('-') or token == '-':
            dropped.append(token)  # the prompt
            continue
        name, has_inline_value = token.split('=', 1)[0], '=' in token
        known = table.get(name)
        group = [token]
        if known is None:
            # Unknown arity: its value, if any, cannot be told from a prompt.
            if not has_inline_value and i < len(args) and not args[i].startswith('-'):
                group.append(args[i])
                i += 1
            (kept if keep_unknown and name not in drop else dropped).extend(group)
            continue
        long_name, arity = known
        if not has_inline_value:
            if arity == 'one' and i < len(args):
                group.append(args[i])
                i += 1
            elif arity == 'optional' and i < len(args) and not args[i].startswith('-'):
                group.append(args[i])
                i += 1
            elif arity == 'many':
                while i < len(args) and not args[i].startswith('-'):
                    group.append(args[i])
                    i += 1
        (dropped if long_name in drop or name in drop else kept).extend(group)
    return kept, dropped


def read_kept(path):
    """{name: value} from the file the plugin left beside the switch file;
    empty when there is none (a plugin before 0.17.0 writes none). A line
    that is not `<model|effort> <value>` is reported and passed over."""
    try:
        with open(path, encoding='utf-8') as handle:
            text = handle.read()
    except FileNotFoundError:
        return {}
    kept = {}
    for line in text.splitlines():
        name, _, value = line.partition(' ')
        if name in KEPT_OPTIONS and KEPT_VALUE.match(value):
            kept[name] = value
        elif line.strip():
            print(f'cca: not keeping {line!r}: not "<model|effort> <value>"', file=sys.stderr)
    return kept


def with_kept(args, kept):
    """`args` (with no prompt) with each kept setting's option in place of
    any the args held, in either spelling (`--model x`, `--model=x`)."""
    options = {KEPT_OPTIONS[name] for name in kept}
    out = []
    i = 0
    while i < len(args):
        token = args[i]
        i += 1
        if token.split('=', 1)[0] in options:
            if '=' not in token and i < len(args):
                i += 1
            continue
        out.append(token)
    for name, value in kept.items():
        out.extend([KEPT_OPTIONS[name], value])
    return out


def main():
    argv = sys.argv[1:]
    kept_file = None
    if argv[:1] == ['--kept'] and len(argv) >= 2:
        kept_file, argv = argv[1], argv[2:]
    if not argv:
        sys.exit('usage: cca-keep-args [--kept FILE] <claude binary> [args...]')
    help_text = subprocess.run([argv[0], '--help'], capture_output=True, text=True, check=True).stdout
    kept, dropped = keep(argv[1:], arities(help_text))
    if dropped:
        print('cca: not carried over: ' + ' '.join(dropped), file=sys.stderr)
    if kept_file is not None:
        kept = with_kept(kept, read_kept(kept_file))
    sys.stdout.write(''.join(arg + '\0' for arg in kept))


if __name__ == '__main__':
    main()
