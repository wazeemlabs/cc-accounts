#!/usr/bin/env python3
"""cca-stream: keeps a VS Code session's process alive across an account switch.

The Claude Code extension starts `cca <its claude> <args>` and talks to it in
stream-json over stdin and stdout. Ending that process for a switch left the
conversation idle until the person sent another message, because only the
panel starts a new one. So cca runs this instead: it starts Claude Code as a
child (through cca again, which picks the account and syncs it) and passes
the panel's lines through. When the plugin asks for a switch it writes the
switch file and ends the child; this then starts a new child on the
conversation (`--resume <id>`, on the account cca recorded for it), replays
the panel's session setup to it, and, when the switch file carries one, sends
the follow-up message that tells the conversation to carry on. The panel
never sees the process end.

The setup replayed is the `initialize` control request and the latest request
of every kind that sets session state (`set_*`, `ui_attach` until a
`ui_detach`). The new child's replies to those replays are dropped: the panel
already had its answers.

No message the panel sends is lost to a switch. Once the switch file exists,
lines are held for the new child. A user message the old child was sent but
never took into a turn is sent to the new one again: with
--replay-user-messages, Claude Code echoes every user message it takes, by
its uuid. When the plugin could not end the child after all, it removes the
switch file and sends SIGUSR1, and the held lines go to the child that is
still running.

Usage: cca-stream --switch FILE --cca CCA --bin CLAUDE -- [claude args]
"""
import argparse
import importlib.machinery
import importlib.util
import json
import os
import re
import signal
import subprocess
import sys
import threading
import uuid

UUID_RE = re.compile(r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
REPLAY_PREFIX = 'cca-replay-'
OUTPUT_GRACE_SECONDS = 10
REPLAY_FLAG = '--replay-user-messages'


def _load_keep_args():
    """libexec/cca-keep-args, which defines what a relaunch carries over."""
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'cca-keep-args')
    loader = importlib.machinery.SourceFileLoader('cca_keep_args', path)
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader('cca_keep_args', loader))
    loader.exec_module(module)
    return module


keep_args = _load_keep_args()


def log(text):
    print(f'cca: {text}', file=sys.stderr, flush=True)


def relaunch_args(args, conversation):
    """The first run's args without the options that choose a conversation
    (cca-keep-args' CONVERSATION, which a terminal relaunch drops too), then
    `--resume <conversation>`. Every other option the panel passed is kept,
    the hidden ones included."""
    kept, _dropped = keep_args.keep(args, {}, drop=keep_args.CONVERSATION, keep_unknown=True)
    return [*kept, '--resume', conversation]


def read_switch(path):
    """(account, conversation id, follow-up text) the plugin asked for, or
    None when there is no request. Raises ValueError on a malformed one."""
    try:
        with open(path, encoding='utf-8') as handle:
            text = handle.read()
    except FileNotFoundError:
        return None
    if text.strip() == '':
        return None
    first, _, rest = text.partition('\n')
    parts = first.split()
    if len(parts) != 2 or not UUID_RE.match(parts[1]):
        raise ValueError(f'switch file held {first!r}, not "<account> <conversation id>"')
    return parts[0], parts[1], rest.strip()


def user_message(text, conversation):
    message = {'type': 'user', 'uuid': str(uuid.uuid4()),
               'message': {'role': 'user', 'content': [{'type': 'text', 'text': text}]},
               'parent_tool_use_id': None, 'session_id': conversation}
    return (json.dumps(message) + '\n').encode()


def user_uuid(line, echo):
    """The uuid of a user message line: one the panel sent, or with `echo`,
    Claude Code's echo of one it took (isReplay). None for anything else."""
    if b'"user"' not in line or (echo and b'"isReplay"' not in line):
        return None
    try:
        value = json.loads(line)
    except ValueError:
        return None
    if not isinstance(value, dict) or value.get('type') != 'user' or (echo and value.get('isReplay') is not True):
        return None
    found = value.get('uuid')
    return found if isinstance(found, str) and found else None


class Unread:
    """The user messages sent to the current child that it has not echoed,
    so has not taken into the conversation. Kept only when the child echoes
    (--replay-user-messages); without echoes nothing can be told apart."""

    def __init__(self, enabled):
        self.enabled = enabled
        self.lock = threading.Lock()
        self.lines = {}

    def sending(self, line):
        """Notes `line` before it is written, so that an echo, which can come
        back before the write returns, finds it. Returns its uuid, or None
        when it is not kept."""
        found = user_uuid(line, echo=False) if self.enabled else None
        if found is not None:
            with self.lock:
                self.lines[found] = line
        return found

    def forget(self, found):
        """A line noted with `sending` that never reached the child."""
        if found is not None:
            with self.lock:
                self.lines.pop(found, None)

    def echoed(self, line):
        found = user_uuid(line, echo=True) if self.enabled else None
        if found is not None:
            with self.lock:
                self.lines.pop(found, None)

    def take(self):
        """The unread lines, in the order sent, forgotten here."""
        with self.lock:
            lines, self.lines = list(self.lines.values()), {}
        return lines


class Setup:
    """The panel's session setup, as it sent it, to replay to a new child."""

    def __init__(self):
        self.requests = {}
        self.replays = 0

    def note(self, line):
        if b'"control_request"' not in line:
            return
        try:
            value = json.loads(line)
        except ValueError:
            # Not JSON: Claude Code will say so; nothing to remember.
            return
        request = value.get('request') if isinstance(value, dict) else None
        subtype = request.get('subtype') if isinstance(request, dict) else None
        if value.get('type') != 'control_request' or not isinstance(subtype, str):
            return
        if subtype == 'ui_detach':
            self.requests.pop('ui_attach', None)
        elif subtype in ('initialize', 'ui_attach') or subtype.startswith('set_'):
            self.requests[subtype] = request

    def replay(self):
        """The recorded requests as lines with fresh ids, initialize first."""
        order = sorted(self.requests, key=lambda subtype: subtype != 'initialize')
        lines = []
        for subtype in order:
            self.replays += 1
            line = {'type': 'control_request', 'request_id': f'{REPLAY_PREFIX}{self.replays}',
                    'request': self.requests[subtype]}
            lines.append((json.dumps(line) + '\n').encode())
        return lines


def read_lines(fd):
    """The lines read from `fd`, the last one even without a newline. Read
    with os.read, not a buffered file: a thread blocked in a buffered read
    holds its lock, and the interpreter aborts at exit when it finds it held."""
    pending = b''
    while True:
        chunk = os.read(fd, 65536)
        if chunk == b'':
            break
        pending += chunk
        *lines, pending = pending.split(b'\n')
        for line in lines:
            yield line + b'\n'
    if pending:
        yield pending


def is_replay_answer(line):
    if REPLAY_PREFIX.encode() not in line:
        return False
    try:
        value = json.loads(line)
    except ValueError:
        return False
    response = value.get('response') if isinstance(value, dict) else None
    request_id = response.get('request_id') if isinstance(response, dict) else None
    return value.get('type') == 'control_response' and str(request_id).startswith(REPLAY_PREFIX)


class Supervisor:
    def __init__(self, options, args):
        self.options = options
        self.args = args
        self.setup = Setup()
        self.lock = threading.Lock()
        self.child = None
        # Lines the panel sent while no child could take them.
        self.held = []
        self.stdin_closed = False
        self.stopping = False
        self.out = sys.stdout.buffer
        self.out_lock = threading.Lock()
        # The child whose output reaches the panel; a reader of an older one
        # (a process it left holding its stdout) is dropped.
        self.output_child = None
        self.unread = Unread(REPLAY_FLAG in args)
        # SIGUSR1 writes here; pump_releases reads it.
        self.release_read, self.release_write = os.pipe()

    def env(self):
        return {**os.environ, 'CCA_STREAM_CHILD': '1', 'CLAUDE_ACCOUNT_SWITCH_FILE': self.options.switch,
                'CCA_STREAM_PID': str(os.getpid())}

    def start(self, args):
        return subprocess.Popen([self.options.cca, self.options.bin, *args], stdin=subprocess.PIPE,
                                stdout=subprocess.PIPE, env=self.env())

    def send(self, child, line):
        """Writes one line to the child; False when it has gone."""
        try:
            child.stdin.write(line)
            child.stdin.flush()
            return True
        except (BrokenPipeError, OSError):
            return False

    def deliver(self, child, line):
        """Sends a panel line to `child`, or holds it when it has gone."""
        noted = self.unread.sending(line)
        if not self.send(child, line):
            self.unread.forget(noted)
            self.held.append(line)

    def holding(self):
        """Whether panel lines wait for a new child. Called with the lock.
        Once the plugin has written a switch request the child is about to
        end, and a line written to it now would be lost."""
        return self.child is None or os.path.exists(self.options.switch)

    def flush_held(self):
        """Sends the held lines to the running child. Called with the lock."""
        held, self.held = self.held, []
        for line in held:
            self.deliver(self.child, line)

    def pump_stdin(self):
        for line in read_lines(sys.stdin.fileno()):
            with self.lock:
                self.setup.note(line)
                if self.holding():
                    self.held.append(line)
                    continue
                self.flush_held()
                self.deliver(self.child, line)
        with self.lock:
            self.stdin_closed = True
            if self.child is not None:
                try:
                    self.child.stdin.close()
                except OSError:
                    # Already gone: its exit is what the main loop waits for.
                    pass

    def pump_stdout(self, child):
        for line in iter(child.stdout.readline, b''):
            if is_replay_answer(line):
                continue
            with self.out_lock:
                if child is not self.output_child:
                    continue
                self.unread.echoed(line)
                self.out.write(line)
                self.out.flush()

    def pump_releases(self):
        """The plugin withdrew a switch it could not carry out (SIGUSR1):
        what was held goes to the child still running."""
        while os.read(self.release_read, 1):
            with self.lock:
                if not self.holding():
                    self.flush_held()

    def release(self, _signum, _frame):
        os.write(self.release_write, b'.')

    def forward(self, signum, _frame):
        if signum != signal.SIGINT:
            self.stopping = True
        child = self.child
        if child is not None and child.poll() is None:
            child.send_signal(signum)

    def attach(self, child, before):
        """Makes `child` current: `before` first, then what the panel sent
        meanwhile."""
        with self.lock:
            held, self.held = self.held, []
            for line in [*before, *held]:
                self.deliver(child, line)
            self.child = child
            if self.stdin_closed:
                child.stdin.close()

    def run(self):
        for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(signum, self.forward)
        signal.signal(signal.SIGUSR1, self.release)
        self.remove_switch()
        child = self.start(self.args)
        self.attach(child, [])
        threading.Thread(target=self.pump_stdin, daemon=True).start()
        threading.Thread(target=self.pump_releases, daemon=True).start()
        while True:
            with self.out_lock:
                self.output_child = child
            reader = threading.Thread(target=self.pump_stdout, args=(child,), daemon=True)
            reader.start()
            status = child.wait()
            # A process the child left behind may hold its stdout open; what
            # it prints after the child's exit is not worth hanging for, and
            # once the next child starts it is dropped.
            reader.join(timeout=OUTPUT_GRACE_SECONDS)
            if reader.is_alive():
                log(f'output still open {OUTPUT_GRACE_SECONDS}s after the process ended; dropping the rest')
            with self.lock:
                self.child = None
            try:
                request = None if self.stopping or self.stdin_closed else read_switch(self.options.switch)
            except ValueError as error:
                log(str(error))
                request = None
            self.remove_switch()
            if request is None:
                return 128 - status if status < 0 else status
            account, conversation, follow_up = request
            log(f'resuming {conversation} on account {account}')
            child = self.start(relaunch_args(self.args, conversation))
            # The setup, the plugin's follow-up, then the messages the old
            # child never took, ahead of what the panel sent meanwhile.
            before = self.setup.replay()
            if follow_up:
                before.append(user_message(follow_up, conversation))
            before.extend(self.unread.take())
            self.attach(child, before)
            # Asked to stop while there was no child to pass it to.
            if self.stopping:
                child.terminate()

    def remove_switch(self):
        try:
            os.remove(self.options.switch)
        except FileNotFoundError:
            pass


def main():
    parser = argparse.ArgumentParser(description='Keep a VS Code session alive across an account switch.')
    parser.add_argument('--switch', required=True, help='the switch file the plugin writes')
    parser.add_argument('--cca', required=True, help='cca, which starts each child on its account')
    parser.add_argument('--bin', required=True, help="the extension's claude binary")
    parser.add_argument('args', nargs=argparse.REMAINDER)
    options = parser.parse_args()
    args = options.args[1:] if options.args[:1] == ['--'] else options.args
    status = Supervisor(options, args).run()
    sys.stdout.flush()
    sys.stderr.flush()
    # The stdin thread is still blocked reading: leave without the
    # interpreter's shutdown, which would wait on or trip over it.
    os._exit(status)


if __name__ == '__main__':
    main()
