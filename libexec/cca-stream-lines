#!/usr/bin/env python3
"""cca-stream-lines: the stream-json lines cca-stream reads between the VS Code
panel and Claude Code, and what it keeps of them across a switch: the user
messages a child has not taken (Unread), the panel's session setup (Setup)
and the control requests in flight each way (Open). Loaded by cca-stream."""
import json
import threading
import uuid

REPLAY_PREFIX = 'cca-replay-'


def parse_control(line):
    """(type, request id, request or response) of a control line, or None for
    any other line. A response's request id is inside its `response`."""
    if b'"control_' not in line:
        return None
    try:
        value = json.loads(line)
    except ValueError:
        return None
    if not isinstance(value, dict):
        return None
    kind = value.get('type')
    if kind == 'control_response':
        body = value.get('response')
        request_id = body.get('request_id') if isinstance(body, dict) else None
    elif kind in ('control_request', 'control_cancel_request'):
        body = value.get('request')
        request_id = value.get('request_id')
    else:
        return None
    if not isinstance(request_id, str):
        return None
    return kind, request_id, body if isinstance(body, dict) else {}


def is_setup(subtype):
    """Whether a request of this kind sets session state, which a new child
    is given again."""
    return subtype in ('initialize', 'ui_attach') or subtype.startswith('set_')


def control_line(value):
    return (json.dumps(value) + '\n').encode()


def user_message(text, conversation):
    message = {'type': 'user', 'uuid': str(uuid.uuid4()),
               'message': {'role': 'user', 'content': [{'type': 'text', 'text': text}]},
               'parent_tool_use_id': None, 'session_id': conversation}
    return (json.dumps(message) + '\n').encode()


def user_uuid(line, echo):
    """The uuid of a user message line: one the panel sent, or with `echo`,
    Claude Code's echo of one it took (isReplay). None for anything else."""
    if b'"user"' not in line or (echo and b'"isReplay"' not in line):
        return None
    try:
        value = json.loads(line)
    except ValueError:
        return None
    if not isinstance(value, dict) or value.get('type') != 'user' or (echo and value.get('isReplay') is not True):
        return None
    found = value.get('uuid')
    return found if isinstance(found, str) and found else None


class Unread:
    """The user messages sent to the current child that it has not echoed,
    so has not taken into the conversation. Kept only when the child echoes
    (--replay-user-messages); without echoes nothing can be told apart."""

    def __init__(self, enabled):
        self.enabled = enabled
        self.lock = threading.Lock()
        self.lines = {}

    def sending(self, line):
        """Notes `line` before it is written, so that an echo, which can come
        back before the write returns, finds it. Returns its uuid, or None
        when it is not kept."""
        found = user_uuid(line, echo=False) if self.enabled else None
        if found is not None:
            with self.lock:
                self.lines[found] = line
        return found

    def forget(self, found):
        """A line noted with `sending` that never reached the child."""
        if found is not None:
            with self.lock:
                self.lines.pop(found, None)

    def echoed(self, line):
        found = user_uuid(line, echo=True) if self.enabled else None
        if found is not None:
            with self.lock:
                self.lines.pop(found, None)

    def from_panel(self, line):
        """The panel withdrew a queued message (cancel_async_message): never
        echoed, it is not one to send a new child."""
        found = parse_control(line)
        if found is not None and found[0] == 'control_request' and found[2].get('subtype') == 'cancel_async_message':
            self.forget(found[2].get('message_uuid') if isinstance(found[2].get('message_uuid'), str) else None)

    def from_child(self, line):
        """An interrupt that also cancelled queued messages lists them in its
        answer."""
        found = parse_control(line)
        if found is None or found[0] != 'control_response' or not isinstance(found[2].get('response'), dict):
            return
        cancelled = found[2]['response'].get('cancelled')
        if isinstance(cancelled, list):
            for message in cancelled:
                self.forget(message if isinstance(message, str) else None)

    def take(self):
        """The unread lines, in the order sent, forgotten here."""
        with self.lock:
            lines, self.lines = list(self.lines.values()), {}
        return lines


# What the panel's own picks of what a move keeps are named: the request that
# sets the model, and the flag setting that sets the effort for the session
# alone. The values the session ran on (cca-keep-args, read_kept) replace them.
KEPT_REQUEST = {'model': 'set_model'}
KEPT_FLAG = {'model': 'model', 'effort': 'effortLevel'}


class Setup:
    """The panel's session setup, as it sent it, to replay to a new child:
    the latest request of each kind, with the id the panel gave it, and the
    settings for the session alone (`apply_flag_settings`), merged as Claude
    Code merges them: each request sets its keys, and a null removes one."""

    def __init__(self):
        self.requests = {}
        self.flags = {}
        self.replays = 0

    def note(self, line):
        found = parse_control(line)
        subtype = found[2].get('subtype') if found is not None and found[0] == 'control_request' else None
        if not isinstance(subtype, str):
            return
        if subtype == 'ui_detach':
            self.requests.pop('ui_attach', None)
        elif subtype == 'apply_flag_settings' and isinstance(found[2].get('settings'), dict):
            for key, value in found[2]['settings'].items():
                if value is None:
                    self.flags.pop(key, None)
                else:
                    self.flags[key] = value
        elif is_setup(subtype):
            self.requests[subtype] = (found[1], found[2])

    def holds(self, request_id):
        return any(held == request_id for held, _request in self.requests.values())

    def replay(self, unanswered=frozenset(), held=frozenset(), kept=None):
        """The recorded requests as lines, initialize first: under a fresh id,
        whose answer is dropped, or under the panel's own when the old child
        never answered it, so the panel gets the new child's answer. Then
        the merged settings for the session alone. A request or setting for
        what the move keeps (`kept`) is left out when the old child answered
        it: the new child starts with the value the session ran on."""
        kept = kept or {}
        order = sorted(self.requests, key=lambda subtype: subtype != 'initialize')
        lines = []
        for subtype in order:
            request_id, request = self.requests[subtype]
            # Held for the new child, it reaches it under its own id.
            if request_id in held:
                continue
            if request_id not in unanswered:
                if any(KEPT_REQUEST.get(name) == subtype for name in kept):
                    continue
                self.replays += 1
                request_id = f'{REPLAY_PREFIX}{self.replays}'
            lines.append(control_line({'type': 'control_request', 'request_id': request_id, 'request': request}))
        flags = {key: value for key, value in self.flags.items() if key not in {KEPT_FLAG[name] for name in kept}}
        if flags:
            self.replays += 1
            lines.append(control_line({'type': 'control_request', 'request_id': f'{REPLAY_PREFIX}{self.replays}',
                                       'request': {'subtype': 'apply_flag_settings', 'settings': flags}}))
        return lines


class Open:
    """The control requests in flight between the panel and the current
    child: the panel's, by id with their kind and line, until the child
    answers; the child's, until the panel answers or the child withdraws."""

    def __init__(self):
        self.lock = threading.Lock()
        self.panel = {}
        self.child = set()

    def sending(self, line):
        """A panel line about to go to the child; returns the id it keeps
        open, for `forget` should the line not reach the child."""
        found = parse_control(line)
        if found is None or found[0] != 'control_request' or found[1].startswith(REPLAY_PREFIX):
            return None
        with self.lock:
            self.panel[found[1]] = (found[2].get('subtype'), line)
        return found[1]

    def forget(self, request_id):
        if request_id is not None:
            with self.lock:
                self.panel.pop(request_id, None)

    def from_panel(self, line):
        """A panel line as it arrives: its answer to a child's question, or
        its withdrawal of a request of its own."""
        found = parse_control(line)
        if found is None:
            return
        kind, request_id, _body = found
        with self.lock:
            if kind == 'control_response':
                self.child.discard(request_id)
            elif kind == 'control_cancel_request':
                self.panel.pop(request_id, None)

    def from_child(self, line):
        found = parse_control(line)
        if found is None:
            return
        kind, request_id, _body = found
        with self.lock:
            if kind == 'control_response':
                self.panel.pop(request_id, None)
            elif kind == 'control_request':
                self.child.add(request_id)
            else:
                self.child.discard(request_id)

    def take(self):
        """(the panel's open requests, the child's open ids), forgotten here."""
        with self.lock:
            panel, child = self.panel, self.child
            self.panel, self.child = {}, set()
        return panel, child


class RemoteControl:
    """Remote Control across a switch. The panel turns it on with a
    `remote_control` request and keeps the bridge epoch of the answer; after
    that it marks Remote Control off only on a `bridge_state` line of
    `failed` or `policy_disabled` that names that epoch, and nothing else
    updates it. A bridge belongs to the account of the process that opened
    it and ends with that process. So a new child is asked to open one on its
    own account (without the old bridge session, which the new account
    cannot take over), its bridge's state lines carry the epoch the panel
    knows, and a child that cannot open one tells the panel it is off. The
    link the panel shows stays the old session's until the panel turns
    Remote Control on again or the tab is reopened."""

    STATE = b'"bridge_state"'

    def __init__(self):
        self.lock = threading.Lock()
        # The panel's remote_control requests the child has not answered.
        self.asked = {}
        # What the panel holds as on: its bridge's epoch and session name.
        self.on = None
        # The epoch of a bridge this opened in the current child, which the
        # panel does not know.
        self.opened = None
        self.replay_id = None
        self.replays = 0

    def from_panel(self, line):
        found = parse_control(line)
        if found is not None and found[0] == 'control_request' and found[2].get('subtype') == 'remote_control':
            with self.lock:
                self.asked[found[1]] = found[2]

    def replay(self):
        """The request that opens a bridge in a new child, or None when the
        panel holds Remote Control off or has a request of its own on the way.
        Called between children."""
        with self.lock:
            self.opened = None
            self.replay_id = None
            if self.on is None or self.asked:
                return None
            self.replays += 1
            self.replay_id = f'{REPLAY_PREFIX}remote-{self.replays}'
            request = {'subtype': 'remote_control', 'enabled': True}
            if self.on[1] is not None:
                request['name'] = self.on[1]
            return control_line({'type': 'control_request', 'request_id': self.replay_id, 'request': request})

    def from_child(self, line):
        """The lines to pass the panel for a line of the child's."""
        found = parse_control(line)
        if found is not None and found[0] == 'control_response':
            return self._answer(line, found[1], found[2])
        if self.STATE not in line:
            return [line]
        try:
            value = json.loads(line)
        except ValueError:
            return [line]
        if not isinstance(value, dict) or value.get('type') != 'system' or value.get('subtype') != 'bridge_state':
            return [line]
        with self.lock:
            if self.on is None:
                return [line]
            epoch = self.on[0]
            if self.opened is not None and value.get('bridge_epoch') == self.opened:
                value = {**value, 'bridge_epoch': epoch}
                line = control_line(value)
            if value.get('state') in ('failed', 'policy_disabled') and value.get('bridge_epoch') in (None, epoch):
                self.on = None
                self.opened = None
        return [line]

    def _answer(self, line, request_id, body):
        with self.lock:
            if request_id == self.replay_id:
                self.replay_id = None
                answer = body.get('response')
                if body.get('subtype') == 'success' and isinstance(answer, dict):
                    self.opened = answer.get('bridge_epoch')
                    return []
                epoch, self.on = self.on[0] if self.on is not None else None, None
                return [control_line({'type': 'system', 'subtype': 'bridge_state', 'state': 'failed',
                                      'detail': 'Remote Control could not start on the account the session moved to',
                                      'bridge_epoch': epoch})]
            request = self.asked.pop(request_id, None)
            if request is None or body.get('subtype') != 'success':
                return [line]
            answer = body.get('response') if isinstance(body.get('response'), dict) else {}
            self.opened = None
            name = request.get('name') if isinstance(request.get('name'), str) else None
            self.on = (answer.get('bridge_epoch'), name) if request.get('enabled') is True else None
        return [line]


def is_replay_answer(line):
    if REPLAY_PREFIX.encode() not in line:
        return False
    found = parse_control(line)
    return found is not None and found[0] == 'control_response' and found[1].startswith(REPLAY_PREFIX)
