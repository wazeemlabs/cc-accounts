#!/bin/bash
# cca: run Claude Code on several accounts and move a conversation between them.
#
# Each account is a Claude Code config dir (CLAUDE_CONFIG_DIR). Conversations,
# the session list and your settings are shared between the accounts, so any
# account can resume any conversation.
#
#   cca init <name>            set up, naming your current account (~/.claude)
#   cca add <name> [dir]       add an account (default dir ~/.claude-<name>) and sign in
#   cca                        list the accounts; * marks where new sessions start
#   cca use <name>             start new sessions on <name> while it has room
#   cca remove <name>          stop using <name>: no session starts or moves
#                              there; its folder and login are left as they are
#   cca <name> [claude args]   run Claude Code on <name>
#   cca run [claude args]      run it on the account the resumed conversation last
#                              used, else where new sessions start (what `claude`
#                              runs after init)
#   cca uninstall              undo init's shell, settings and VS Code changes
#   cca version | help
#
# Inside a session, /account <name> moves the conversation to <name> once its
# turn and background work have finished (/account <name> now does not wait):
# in a terminal it closes and reopens on <name> with the same flags; in VS Code
# it reopens on <name> in the same tab. A session whose account is nearly
# spent moves to the account with the most room by itself (CCA_BALANCE=off
# stops it).
set -euo pipefail

ROOT="${CCA_ROOT:-$HOME/.claude-shared/accounts}"
SHARED="${CCA_SHARED:-$HOME/.claude-shared}"
TABLE="$ROOT/accounts.tsv"
# The account Claude Code uses with no CLAUDE_CONFIG_DIR. It runs with the
# variable unset: set, even to this path, it keys a credential entry of its own
# and the account reads as signed out.
HOME_DIR="$HOME/.claude"
# Kept in the shared dir and linked into every account: what makes one
# account's conversations and sessions visible to the others.
SHARED_STATE=(projects todos file-history sessions)
# The user MCP servers, in one file every session cca starts loads with
# --mcp-config; cca-sync moves a server added to an account's config here.
MCP_FILE="$SHARED/mcp.json"
# Linked from ~/.claude into every other account unless share.conf says otherwise.
DEFAULT_SHARE=(settings.json CLAUDE.md agents commands keybindings.json)
RESERVED=" init add use remove run uninstall version help default usage priority now "
UUID_RE='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
# The plugin rewrites a conversation's record each time it starts, so a record
# this old belongs to a conversation nobody has opened since; it then opens on
# the default account.
RECORD_DAYS=180
# The plugin's Stop hook leaves each session's background work in
# background/<id>, read only at the end of the turn that wrote it, and the
# plugin records an account's failures in blocked/<account>/<scope>.json,
# which count for an hour: a day-old one of either is never read again.
SHORT_RECORD_DAYS=1
# Settings the editor saves by running the binary once with one of these
# subcommands (VS Code's Claude in Chrome and memory dialogs). They live in
# each account's .claude.json, and the editor runs the helper itself, with
# no conversation named, so nothing says whose panel asked. cca runs it on
# every account, which keeps the setting the same everywhere, like a shared one.
PREFERENCE_EDITS=" edit-chrome-settings edit-memory-settings "
# The plugin publishes where a new session should start (accounts/start),
# from every account's usage, at the end of every session's turns. A choice
# older than this belongs to readings nobody has refreshed, and the default
# is taken instead.
START_MINUTES=60

# Where this script really is, through the link install.sh makes.
self="$0"
while [[ -L "$self" ]]; do
  link="$(readlink "$self")"
  if [[ "$link" == /* ]]; then self="$link"; else self="$(dirname "$self")/$link"; fi
done
HERE="$(cd "$(dirname "$self")/.." && pwd -P)"
LIBEXEC="$HERE/libexec"
PLUGIN="$HERE/plugin"
export CCA_ROOT="$ROOT" CCA_SHARED="$SHARED"

die() { echo "cca: $*" >&2; exit 2; }

names() { [[ -f "$TABLE" ]] && cut -f1 "$TABLE"; return 0; }

dir_of() {
  [[ -f "$TABLE" ]] || return 0
  awk -F'\t' -v n="$1" '$1 == n { print $2 }' "$TABLE"
}

# An account's global config, where its login and folder trust live.
config_of() {
  if [[ "$1" == "$HOME_DIR" ]]; then echo "$HOME/.claude.json"; else echo "$1/.claude.json"; fi
}

email_of() {
  local config; config="$(config_of "$1")"
  [[ -f "$config" ]] || return 0
  python3 -I -c 'import json,sys
try:
    print((json.load(open(sys.argv[1])).get("oauthAccount") or {}).get("emailAddress") or "")
except ValueError:
    print("")' "$config"
}

default_name() {
  if [[ -s "$ROOT/default" ]]; then
    head -1 "$ROOT/default"
  else
    names | head -1
  fi
}

# The account a new conversation starts on: the plugin's choice while it is
# fresh, newer than the default (`cca use` or /account default set since
# wins until the plugin chooses again) and names an account in the table;
# otherwise the default.
start_name() {
  local file="$ROOT/start" name
  if [[ -s "$file" && -z "$(find "$file" -mmin +"$START_MINUTES")" ]] \
    && [[ ! -e "$ROOT/default" || "$file" -nt "$ROOT/default" ]]; then
    name="$(head -1 "$file")"
    if [[ -n "$(dir_of "$name")" ]]; then echo "$name"; return 0; fi
  fi
  default_name
}

require_account() {
  [[ -n "$(dir_of "$1")" ]] || die "no account named '$1' (accounts: $(names | paste -sd' ' -))"
}

valid_name() {
  [[ "$1" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "an account name is lowercase letters, digits and dashes"
  [[ "$RESERVED" != *" $1 "* ]] || die "'$1' is a cca command"
}

# Whether the args read stream-json on stdin: a VS Code panel's session,
# which cca-stream can keep alive across a switch. A terminal running
# `cca <claude> ...` reads a person's keys and runs Claude Code itself.
reads_stream_json() {
  local previous="" a
  for a in "$@"; do
    [[ "$a" == --input-format=stream-json || ( "$previous" == --input-format && "$a" == stream-json ) ]] && return 0
    previous="$a"
  done
  return 1
}

# The conversation id a --resume / -r argument names, if any.
resume_id() {
  local next="" a
  for a in "$@"; do
    if [[ -n "$next" ]]; then
      [[ "$a" =~ $UUID_RE ]] && echo "$a"
      return 0
    fi
    case "$a" in
      --resume|-r) next=1 ;;
      --resume=*) [[ "${a#--resume=}" =~ $UUID_RE ]] && echo "${a#--resume=}"; return 0 ;;
    esac
  done
  return 0
}

# Which account a run with these args starts on.
choose() {
  local id; id="$(resume_id "$@")"
  if [[ -n "$id" && -s "$ROOT/by-session/$id" ]]; then
    local recorded; recorded="$(head -1 "$ROOT/by-session/$id")"
    if [[ -n "$(dir_of "$recorded")" ]]; then echo "$recorded"; return; fi
  fi
  if [[ -n "${CLAUDE_ACCOUNT:-}" && -n "$(dir_of "$CLAUDE_ACCOUNT")" ]]; then
    echo "$CLAUDE_ACCOUNT"; return
  fi
  start_name
}

apply() {
  # No accounts registered: Claude Code runs as it would without cca.
  [[ -n "$1" ]] || return 0
  local dir; dir="$(dir_of "$1")"
  export CLAUDE_ACCOUNT="$1"
  if [[ "$dir" == "$HOME_DIR" ]]; then unset CLAUDE_CONFIG_DIR; else export CLAUDE_CONFIG_DIR="$dir"; fi
  # Claude Code lets a memory write through by comparing the file's real path
  # with the memory folder's path as configured, and every account reaches
  # the conversations (where memory lives) through a link to the shared
  # folder, so each write would ask. This names the folder by its real path.
  export CLAUDE_CODE_REMOTE_MEMORY_DIR="$SHARED"
}

claude_bin() {
  [[ -n "${CCA_CLAUDE:-}" ]] && { echo "$CCA_CLAUDE"; return; }
  [[ -x "$HOME/.local/bin/claude" ]] && { echo "$HOME/.local/bin/claude"; return; }
  command -v claude || die "no claude binary found; install Claude Code first"
}

# Before a session starts, move the user MCP servers its account holds into
# MCP_FILE and give it the folder trust and per-project MCP settings the
# other accounts have (libexec/cca-sync), so every account loads the same
# tools. CCA_TRUST_SYNC=off and CCA_MCP_SYNC=off turn each off; MCP_FILE is
# loaded either way. A failure is reported, not fatal.
sync_account() {
  local bin="$1" account="$2" name dir configs=() kinds=()
  [[ -n "$account" && -f "$TABLE" ]] || return 0
  [[ "${CCA_TRUST_SYNC:-on}" == off ]] && kinds+=(--no-trust)
  [[ "${CCA_MCP_SYNC:-on}" == off ]] && kinds+=(--no-mcp)
  [[ ${#kinds[@]} -lt 2 ]] || return 0
  while IFS=$'\t' read -r name dir; do configs+=("$(config_of "$dir")"); done < "$TABLE"
  [[ ${#configs[@]} -gt 1 ]] || return 0
  "$LIBEXEC/cca-sync" --binary "$bin" --home "$(config_of "$HOME_DIR")" \
    --target "$(config_of "$(dir_of "$account")")" --state "$ROOT/sync-state.json" --servers "$MCP_FILE" \
    ${kinds[@]+"${kinds[@]}"} "${configs[@]}" \
    || echo "cca: trust and MCP servers were not synced to $account" >&2
}

prune_short_records() {
  local dir
  for dir in "$ROOT/background" "$ROOT/blocked"; do
    [[ -d "$dir" ]] || continue
    find "$dir" -type f -mtime +"$SHORT_RECORD_DAYS" -delete
    find "$dir" -mindepth 1 -type d -empty -delete
  done
}

# Run in the terminal, relaunching on the account a /account switch asks for.
launch() {
  local account="$1"; shift
  local bin; bin="$(claude_bin)"
  mkdir -p "$ROOT/switch"
  # Global: the EXIT trap reads it after this function has returned.
  SWITCH="$ROOT/switch/$$"
  local switch="$SWITCH"
  # The plugin checks CCA_PID is its parent, so a claude started inside this
  # session (inheriting these) cannot switch this one.
  export CLAUDE_ACCOUNT_SWITCH_FILE="$switch" CCA_MODE=terminal CCA_PID=$$
  trap 'rm -f "$SWITCH"' EXIT
  local args=("$@") first=("$@")
  if [[ -d "$ROOT/by-session" ]]; then
    find "$ROOT/by-session" -type f -mtime +"$RECORD_DAYS" -delete
  fi
  prune_short_records
  while :; do
    rm -f "$switch"
    apply "$account"
    sync_account "$bin" "$account"
    # In front, as --mcp-config=FILE: the option takes several values, and
    # this form leaves a prompt or subcommand after it alone.
    local status=0 load=()
    if [[ -f "$MCP_FILE" ]]; then load=("--mcp-config=$MCP_FILE"); fi
    "$bin" ${load[@]+"${load[@]}"} ${args[@]+"${args[@]}"} || status=$?
    [[ -s "$switch" ]] || return "$status"
    # Line one names the account and conversation; the rest, when there is
    # any, is the message the reopened conversation starts with.
    local next_account id follow_up
    read -r next_account id < "$switch"
    follow_up="$(tail -n +2 "$switch")"
    [[ -n "$(dir_of "$next_account")" && "$id" =~ $UUID_RE ]] \
      || die "switch file held '$next_account $id', not '<account> <conversation id>'"
    echo "cca: resuming $id on account $next_account" >&2
    account="$next_account"
    args=()
    local arg
    while IFS= read -r -d '' arg; do args+=("$arg"); done \
      < <("$LIBEXEC/cca-keep-args" "$bin" ${first[@]+"${first[@]}"})
    args+=(--resume "$id")
    if [[ -n "$follow_up" ]]; then args+=("$follow_up"); fi
  done
}

list() {
  [[ -f "$TABLE" ]] || { echo "No accounts yet: cca init <name>"; return 0; }
  local def start name dir; def="$(default_name)"; start="$(start_name)"
  while IFS=$'\t' read -r name dir; do
    local email; email="$(email_of "$dir")"
    printf '%s %-10s %-32s %s\n' "$([[ "$name" == "$start" ]] && echo '*' || echo ' ')" \
      "$name" "${email:-(not signed in)}" "$dir"
  done < "$TABLE"
  if [[ "$start" == "$def" ]]; then
    echo "* new sessions start here. Move a running one with /account <name>."
  else
    echo "* new sessions start here; $def, the default, is low on room. Move a running one with /account <name>."
  fi
}

# Run a preference edit (see PREFERENCE_EDITS) on every account, feeding each
# the same stdin. Stops at the first account that fails, with its status.
edit_everywhere() {
  local bin="$1"; shift
  local input name dir out status
  input="$(cat)"
  while IFS=$'\t' read -r name dir; do
    out="$(printf '%s' "$input" | (apply "$name"; CCA_MODE=stream CCA_PID=$$ exec "$bin" "$@"))" \
      || { status=$?; printf '%s\n' "$out"; exit "$status"; }
  done < "$TABLE"
  printf '%s\n' "$out"
  exit 0
}

# The account set-up commands (init, add's linking, remove).
# shellcheck source=libexec/cca-manage.sh
. "$LIBEXEC/cca-manage.sh"

case "${1:-}" in
  "") list ;;
  # The comment block at the top, whatever its length.
  help|-h|--help) awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$self" ;;
  version|-v|--version) echo "cca $(cat "$HERE/VERSION")" ;;
  init)
    [[ $# -ge 2 && $# -le 3 ]] || die "usage: cca init <name> [--yes]"
    [[ $# -eq 2 || "$3" == --yes ]] || die "usage: cca init <name> [--yes]"
    init "$2" "$([[ "${3:-}" == --yes ]] && echo yes || echo no)"
    ;;
  uninstall)
    "$LIBEXEC/cca-setup" uninstall --rc "$(shell_rc)" --settings "$HOME_DIR/settings.json" \
      --plugin "$PLUGIN" --wrapper "$HERE/bin/cca"
    echo "Your accounts, conversations and $SHARED are left as they are."
    ;;
  use)
    [[ $# -eq 2 ]] || die "usage: cca use <name>"
    require_account "$2"
    printf '%s\n' "$2" > "$ROOT/default"
    echo "New sessions start on $2."
    ;;
  remove)
    [[ $# -eq 2 ]] || die "usage: cca remove <name>"
    remove_account "$2"
    ;;
  add)
    [[ $# -ge 2 && $# -le 3 ]] || die "usage: cca add <name> [dir]"
    [[ -f "$TABLE" ]] || die "run cca init <name> first, naming your current account"
    name="$2"
    valid_name "$name"
    dir="${3:-$HOME/.claude-$name}"
    dir="$(mkdir -p "$dir" && cd "$dir" && pwd -P)"
    existing="$(dir_of "$name")"
    [[ -z "$existing" || "$existing" == "$dir" ]] || die "'$name' is already $existing"
    owner="$(awk -F'\t' -v d="$dir" -v n="$name" '$2 == d && $1 != n { print $1 }' "$TABLE")"
    [[ -z "$owner" ]] || die "$dir is already the account '$owner'"
    if [[ -z "$existing" ]]; then printf '%s\t%s\n' "$name" "$dir" >> "$TABLE"; fi
    link_shared "$dir"
    if [[ -z "$(email_of "$dir")" ]]; then
      echo "Account $name is $dir. Starting Claude Code on it: sign in with /login."
      launch "$name"
    else
      echo "Account $name is $dir, signed in as $(email_of "$dir")."
    fi
    ;;
  run) shift; launch "$(choose "$@")" "$@" ;;
  /*)
    # VS Code's claudeProcessWrapper: the extension's own binary first. A
    # session the panel talks to in stream-json runs under
    # libexec/cca-stream, which starts Claude Code
    # through this branch again (CCA_STREAM_CHILD) and, when /account or the
    # balancer ends it for a switch, starts it again on the new account with
    # the panel still attached. The child runs here with exec, keeping its
    # pid, so CCA_PID is Claude Code's own.
    [[ -x "$1" ]] || die "not an executable: $1"
    bin="$1"; shift
    if [[ -n "$(names)" && "$PREFERENCE_EDITS" == *" ${1:-} "* && -z "$(resume_id "$@")" && -z "${CLAUDE_ACCOUNT:-}" ]]; then
      edit_everywhere "$bin" "$@"
    fi
    if [[ -z "${CCA_STREAM_CHILD:-}" && -n "$(names)" && "${1:-}" == -* ]] && reads_stream_json "$@"; then
      mkdir -p "$ROOT/switch"
      exec python3 -I "$LIBEXEC/cca-stream" --switch "$ROOT/switch/$$" --cca "$HERE/bin/cca" --bin "$bin" -- "$@"
    fi
    name="$(choose "$@")"
    apply "$name"
    # A session starts with an option; a subcommand (plugin list, edit-hook)
    # starts none and needs nothing synced or loaded.
    if [[ -z "${1:-}" || "$1" == -* ]]; then
      sync_account "$bin" "$name"
      prune_short_records
      if [[ -f "$MCP_FILE" ]]; then set -- "--mcp-config=$MCP_FILE" "$@"; fi
    fi
    # A child of cca-stream keeps the switch file it was given; any other
    # run has no supervisor to read one.
    [[ -n "${CCA_STREAM_CHILD:-}" ]] || unset CLAUDE_ACCOUNT_SWITCH_FILE
    unset CCA_STREAM_CHILD
    export CCA_MODE=stream CCA_PID=$$
    exec "$bin" "$@"
    ;;
  *)
    require_account "$1"
    name="$1"; shift
    launch "$name" "$@"
    ;;
esac
